{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["DOM", "ES2015", "ES2016.Array.Include", "ES2017.Object"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "../release",
    "removeComments": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es6"
  },
  "include": ["src/**/*"]
}
